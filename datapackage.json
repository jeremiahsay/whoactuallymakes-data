   "schema": {
    "fields": [
     {
      "name": "id",
      "type": "string",
      "description": "Our ID for the record. Stable: it never changes or gets reused."
     },
     {
      "name": "source",
      "type": "string",
      "description": "ID of the source it comes from (see the Sources dataset)."
